# Reverse proxy for a single-machine deployment. Caddy gets and renews the
# Let's Encrypt certificate itself (ports 80 and 443 must reach this machine),
# and proxies WebSockets without extra config.
#
#   DOMAIN=whiteboard.example.com WHITEBOARD_DIST=/path/to/WhiteBoard/frontend/dist caddy run --config deploy/Caddyfile
#
# Routes must match frontend/vite.config.js (dev proxy) and lib/endpoints.js.
{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /sync/* {
		reverse_proxy 127.0.0.1:5858
	}

	# LiveKit signalling (the audio call's control channel). Media does NOT
	# go through here - it's UDP 7882 / TCP 7881 straight to the machine.
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880
	}

	handle {
		root * {$WHITEBOARD_DIST}
		try_files {path} /index.html
		file_server
	}
}
